# Chave Groq — não commitar valores reais. Copia para .env.local e obtém a chave em:
# https://console.groq.com/keys
# O Vite só expõe variáveis com prefixo VITE_ ao código do browser.
VITE_GROQ_API_KEY=

# Opcional — modelo de chat (predefinido: openai/gpt-oss-20b, adequado ao plano gratuito).
# Alternativas: openai/gpt-oss-120b | qwen/qwen3.6-27b
# VITE_GROQ_MODEL=openai/gpt-oss-20b
